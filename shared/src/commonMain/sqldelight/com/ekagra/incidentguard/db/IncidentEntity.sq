CREATE TABLE incidentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    severity TEXT NOT NULL,
    status TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    temperature REAL,
    weatherCondition TEXT,
    localImagePath TEXT,
    remoteImageUrl TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 0
);

selectAllIncidents:
SELECT *
FROM incidentEntity
ORDER BY createdAt DESC;

selectIncidentById:
SELECT *
FROM incidentEntity
WHERE id = ?;

selectUnsyncedIncidents:
SELECT *
FROM incidentEntity
WHERE isSynced = 0;

insertOrReplaceIncident:
INSERT OR REPLACE INTO incidentEntity (
    id, title, description, severity, status,
    latitude, longitude, temperature, weatherCondition,
    localImagePath, remoteImageUrl, createdAt, updatedAt, isSynced
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSyncStatus:
UPDATE incidentEntity
SET isSynced = ?, remoteImageUrl = ?, updatedAt = ?
WHERE id = ?;

deleteIncidentById:
DELETE FROM incidentEntity
WHERE id = ?;